# Copy to .env and choose your own value. .env is gitignored and never committed.
#
# SQL Server rejects weak passwords, so it needs upper case, lower case, a digit and a symbol,
# and at least eight characters.
#
# Whatever you set here must match the password in the connection string you give to
# dotnet user-secrets. The README has both commands.
MSSQL_SA_PASSWORD=Choose_A_Strong_Passw0rd!
