<?xml version="1.0" encoding="utf-8"?>
<!--
  Restores from nuget.org only. Machine-level configuration on a developer box often adds private
  feeds that a reviewer cannot authenticate against, which turns a clean clone into a 401.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
